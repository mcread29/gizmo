{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Gizmo",
	"version": "0.1.0",
	"identifier": "dev.genge.unity-agent",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Gizmo",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 640,
				"decorations": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' blob:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:8787; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": ["binaries/unity-agent-server"]
	}
}
