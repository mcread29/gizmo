{
	"name": "gizmo",
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"check": "pnpm check:loc && pnpm check:hooks && pnpm -r --if-present check",
		"check:loc": "node scripts/check-file-lengths.mjs",
		"check:hooks": "node scripts/check-ui-hooks.mjs",
		"dev": "pnpm --parallel --filter @gizmo/agent-server --filter @gizmo/app dev",
		"dev:server": "tsx scripts/dev-server.ts",
		"dev:server:start": "pnpm dev:server start",
		"dev:server:stop": "pnpm dev:server stop",
		"dev:server:restart": "pnpm dev:server restart",
		"dev:server:status": "pnpm dev:server status",
		"web:server": "tsx scripts/web-server.ts",
		"web:server:start": "pnpm web:server start",
		"web:server:stop": "pnpm web:server stop",
		"web:server:restart": "pnpm web:server restart",
		"web:server:status": "pnpm web:server status",
		"pi-web:dev": "cross-env GIZMO_PI_WEB=1 pnpm --parallel --filter @gizmo/agent-server --filter @gizmo/app dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm -r --if-present test"
	},
	"devDependencies": {
		"cross-env": "^10.1.0",
		"prettier": "latest",
		"prettier-plugin-svelte": "latest",
		"tsx": "^4.23.12",
		"typescript": "^6.0.0"
	}
}
