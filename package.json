{
	"name": "gizmo",
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"build": "pnpm -r --if-present build",
		"check": "pnpm -r --if-present check",
		"desktop:build": "pnpm --filter @unity-agent/app desktop:build",
		"desktop:dev": "pnpm --filter @unity-agent/app desktop:dev",
		"dev": "pnpm --parallel --filter @unity-agent/agent-server --filter @unity-agent/app dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm -r --if-present test"
	},
	"devDependencies": {
		"prettier": "latest",
		"prettier-plugin-svelte": "latest",
		"typescript": "^6.0.0"
	}
}
